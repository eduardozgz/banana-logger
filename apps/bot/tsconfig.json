{
  "extends": "@bl/tsconfig/base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json",
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "outDir": "./dist",
    "noEmit": false
  },
  "include": [
    "*.ts",
    "src",
    "test",
    "scripts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
