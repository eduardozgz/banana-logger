{
  "name": "@bl/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "pnpm generate:sqlite && pnpm generate:pg",
    "generate:sqlite": "drizzle-kit generate --config=drizzle.sqlite.config.ts",
    "generate:pg": "drizzle-kit generate --config=drizzle.pg.config.ts",
    "migrate": "pnpm with-env tsx src/migrate.ts",
    "studio": "pnpm with-env drizzle-kit studio --config=drizzle.sqlite.config.ts",
    "studio:pg": "pnpm with-env drizzle-kit studio --config=drizzle.pg.config.ts",
    "with-env": "dotenv -e ../../.env --"
  },
  "devDependencies": {
    "@bl/eslint-config": "workspace:*",
    "@bl/prettier-config": "workspace:*",
    "@bl/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "drizzle-kit": "^0.31.1",
    "eslint": "catalog:eslint",
    "prettier": "catalog:prettier",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "^4.1.2"
  },
  "prettier": "@bl/prettier-config",
  "dependencies": {
    "@bl/logger": "workspace:*",
    "@libsql/client": "^0.15.7",
    "@t3-oss/env-core": "catalog:",
    "drizzle-orm": "^0.44.2",
    "postgres": "^3.4.5",
    "zod": "catalog:"
  }
}
