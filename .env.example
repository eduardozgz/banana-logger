# Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# GENERAL
# =============================================================================

# Node environment (development, production, test)
NODE_ENV=production

# Log level for application logging (error, warn, info, debug)
LOG_LEVEL=info

PUBLIC_URL=http://localhost

# =============================================================================
# DISCORD BOT
# =============================================================================

# Discord bot token for the specific bot instance
DISCORD_BOT_INSTANCE_TOKEN=your_discord_bot_token_here

# Discord application client ID
DISCORD_CLIENT_ID=your_discord_client_id_here

# Whether to deploy slash commands on bot startup (true/false or a guild id to deploy there)
DISCORD_BOT_INSTANCE_DEPLOY_COMMANDS=true

# =============================================================================
# DASHBOARD BACKEND (OAuth + session)
# =============================================================================
# Required by the backend service; without them it fails env validation on boot.

# Public URL of the dashboard frontend (used for OAuth redirects / CORS)
WEBSITE_URL=http://localhost:3000

# Port the backend API binds. The docker-compose stack overrides this to 3000;
# leave the default for local runs.
BACKEND_PORT=8080

# Number of trusted reverse proxies in front of the backend (for correct client IPs)
BACKEND_MAX_TRUSTED_PROXIES=0

# Secret used to sign session cookies — MUST be at least 32 characters
COOKIE_SECRET=change_me_to_a_random_secret_at_least_32_chars

# Discord OAuth2 credentials for dashboard login. The redirect URI must match the
# one registered on your Discord application and the backend's callback route.
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_OAUTH2_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# =============================================================================
# REST PROXY (optional)
# =============================================================================

# Shared Discord REST proxy (@bl/rest-proxy). When set, the bot routes all REST
# through it so one rate limiter owns the token's global budget — recommended
# when running multiple shards/processes on the same token. Leave unset to have
# the bot talk to Discord directly.
# In the docker-compose stack, point it at the bundled service:
# DISCORD_BOT_INSTANCE_REST_PROXY_URL=http://rest-proxy:8765/api

# Port the proxy listens on (defaults to 8765)
# REST_PROXY_PORT=8765

# =============================================================================
# DATABASE
# =============================================================================

# Database connection URL.
# Leave UNSET for the docker-compose stack: it defaults to the absolute
# file:/app/storage/banana-logger.db on the shared named volume (cwd-independent,
# so the migrate job and the apps resolve the same file). Uncomment to override —
# e.g. for local (non-docker) runs, or to use Postgres:
# DATABASE_URL=file:./storage/banana-logger.db
# DATABASE_URL=postgres://banana:banana@postgres:5432/banana-logger

# =============================================================================
# REDIS
# =============================================================================

# Redis connection URL
# Example: redis://localhost:6379
# Example with auth: redis://username:password@localhost:6379
REDIS_URL=redis://redis:6379

# =============================================================================
# IMG service
# =============================================================================

IMG_PORT=3000
# No trailing slash: templates build the swatch URL as {IMG_PUBLIC_URL}/color/...
# and a trailing slash here yields a //color/... path the img service 404s on.
IMG_PUBLIC_URL=http://localhost:3000